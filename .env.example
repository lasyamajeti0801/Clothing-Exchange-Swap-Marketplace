# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:5000

# Security
JWT_SECRET=super_secret_jwt_key_change_in_production_min_32_chars

# Database (SQLite default for local dev, PostgreSQL for production)
DATABASE_URL="file:./dev.db"
# For PostgreSQL: DATABASE_URL="postgresql://postgres:password@localhost:5432/rewear?schema=public"

# Optional Cloudinary (If left empty, system uses local storage /uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
