{
  "name": "rewear-server",
  "version": "1.0.0",
  "type": "module",
  "description": "ReWear - Sustainable Clothing Exchange Backend API",
  "main": "src/index.js",
  "scripts": {
    "dev": "node --watch src/index.js",
